# Copy to .env and chmod 600. Never commit .env or a token file.
# Schwab allows one product per app. Leave every value blank in this example.

# Market Data app. Quotes, history, candles, and the 7-day banner.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=
SCHWAB_TOKEN_PATH=

# Accounts and Trading app. Account lookup and place_order only.
SCHWAB_TRADE_APP_KEY=
SCHWAB_TRADE_APP_SECRET=
SCHWAB_TRADE_CALLBACK_URL=
SCHWAB_TRADE_TOKEN_PATH=

SCREENER_MODE=
