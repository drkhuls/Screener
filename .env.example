# Copy to .env (chmod 600). Never commit .env.

# Schwab app from developer.schwab.com. Leave the key empty to run on demo data.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Where `python backend.py login` writes the token. Empty means token.json next to backend.py.
SCHWAB_TOKEN_PATH=/opt/market-dashboard/token.json

HOST=0.0.0.0
PORT=8000

# HTTP basic auth for the dashboard; enforced when both are set. Strongly recommended on a public server.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Force a mode instead of picking schwab when SCHWAB_APP_KEY is set: schwab or demo.
SCREENER_MODE=

# Order alerts. Leave both empty to skip. Set them only in this local file, never in source.
# Email is sent when SMTP_HOST is set; otherwise the server logs the message. SMS is a log line only.
ORDER_ALERT_EMAIL=
ORDER_ALERT_PHONE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
